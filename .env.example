# Roots of Brazil — variáveis de ambiente do docker-compose.
# Copie para .env e preencha. O .env real é ignorado pelo git — nunca comite senha.

# --- PostgreSQL (Ordem 2 / produção) ---
POSTGRES_USER=roots
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=roots_of_brazil
DATABASE_URL=postgresql+psycopg://roots:troque-esta-senha@postgres:5432/roots_of_brazil

# --- Neo4j (Ordem 3) ---
# NEO4J_URI usa o nome do serviço do compose quando lido de dentro da rede do compose;
# de fora (rodando o ETL na máquina), use bolt://localhost:7687.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha
NEO4J_DATABASE=neo4j

# Banco separado usado pelos testes de integração da Ordem 3, que ESCREVEM e APAGAM
# nós. Nunca aponte para o banco de trabalho. Os testes só rodam com ROOTS_TESTE_NEO4J=1.
# NEO4J_DATABASE=roots_teste
# ROOTS_TESTE_NEO4J=1
